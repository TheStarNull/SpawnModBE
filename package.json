{
  "name": "spawnmodbe",
  "version": "1.0.0",
  "description": "A TypeScript framework that generates Minecraft Bedrock Edition (MCBE) mods/addons via the Script API (SAPI).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spawnmodbe": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build:test && node dist/test/smoke.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "cli": "npm run build && node dist/cli.js",
    "example": "npm run build:test && node dist/example/index.js",
    "example:no-sapi": "npm run build:test && node dist/example/example-no-sapi.js",
    "example:frostmoon": "npm run build:test && node dist/example/frostmoon.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "mcbe",
    "addon",
    "mod",
    "script-api",
    "sapi",
    "typescript"
  ],
  "devDependencies": {
    "@minecraft/server": "^2.10.0",
    "@types/node": "^26.6.2",
    "typescript": "^5.7.3"
  }
}
